datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler 6543
  directUrl = env("DIRECT_URL")   // host direto 5432 (SSL)
}

generator client {
  provider = "prisma-client-js"
}

/**
 * =========================
 * Core: Clients / Techs / Visits
 * =========================
 */
model Client {
  id                String  @id @default(cuid())

  // Pessoa
  firstName         String
  lastName          String
  email             String  @unique
  phone             String? @unique
  cpf               String? @unique

  // Empresa (opcional)
  companyName       String?
  cnpj              String? @unique

  // Endereço de cobrança (billing)
  street            String?
  number            String?
  district          String?
  city              String?
  uf                String?
  cep               String?

  // Informações úteis
  notes             String?

  // Localização da piscina
  poolStreet        String?
  poolNumber        String?
  poolDistrict      String?
  poolCity          String?
  poolUf            String?
  poolCep           String?

  // (legado – mantidos, mas você pode remover depois)
  poolSize          String?
  cleaningFrequency Int?
  cleaningWindow    String?
  payDay            Int?

  active            Boolean @default(true)

  visits            Visit[]
  visitPlans        VisitPlan[]     @relation("ClientToVisitPlan")
  visitInstances    VisitInstance[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([city])
  @@index([poolCity])
}

enum TechnicianRole {
  OWNER
  TECH
}

model Technician {
  id           String          @id @default(uuid())
  userId       String?         @unique @db.Uuid
  firstName    String          @map("first_name")
  lastName     String          @map("last_name")
  email        String          @unique
  phone        String?         @map("phone")
  cpf          String?         @unique
  active       Boolean         @default(true)
  role         TechnicianRole  @default(TECH)

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt      @map("updated_at")

  phoneDigits  String?         @map("phone_digits")

  visits         Visit[]
  visitPlans     VisitPlan[]     @relation("TechnicianToVisitPlan")
  visitInstances VisitInstance[]

  @@index([phone])
  @@index([phoneDigits])
}

model Visit {
  id     String   @id @default(uuid())
  date   DateTime
  status String   @default("pending")

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model VisitPlan {
  id           String  @id @default(cuid())
  technicianId String
  clientId     String
  weekdays     Int[] // 1..6 (Seg..Sáb)
  windowStart  Int
  windowEnd    Int
  notes        String?
  order        Int     @default(0)
  active       Boolean @default(true)

  technician Technician @relation("TechnicianToVisitPlan", fields: [technicianId], references: [id])
  client     Client     @relation("ClientToVisitPlan", fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances VisitInstance[]
}

model VisitInstance {
  id        String   @id @default(cuid())
  date      DateTime
  startHour Int
  endHour   Int
  order     Int      @default(100)
  status    String   @default("planned")
  notes     String?

  // CASCADE ao apagar o VisitPlan
  planId String?
  plan   VisitPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, technicianId])
  @@index([planId])
}

/**
 * =========================
 * Rotas (Templates & Ocorrências)
 * =========================
 */
enum ServiceFrequency {
  ONCE
  WEEKLY
  BIWEEKLY_A
  BIWEEKLY_B
  MONTHLY_DAY
  MONTHLY_NTHWEEK
}

enum EndCondition {
  NO_END
  AFTER_OCCURRENCES
  END_DATE
}

model RouteTemplate {
  id           String           @id @default(cuid())
  workspaceId  String
  technicianId String
  weekday      Int // 1..7
  frequency    ServiceFrequency
  startDate    DateTime
  endCondition EndCondition
  endAfter     Int?
  endDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  stops       RouteStopTemplate[] @relation("TemplateStops")
  occurrences RouteOccurrence[]
}

model RouteStopTemplate {
  id          String    @id @default(cuid())
  templateId  String
  order       Int
  clientId    String
  durationMin Int       @default(30)
  windowStart DateTime?
  windowEnd   DateTime?
  note        String?
  clientLat   Float?
  clientLng   Float?
  addressLine String?

  template RouteTemplate @relation("TemplateStops", fields: [templateId], references: [id])

  @@index([templateId, order])
}

model RouteOccurrence {
  id          String    @id @default(cuid())
  templateId  String
  date        DateTime
  optimizedAt DateTime?
  distanceKm  Float?
  durationMin Int?

  template RouteTemplate @relation(fields: [templateId], references: [id])

  stops RouteStopOccurrence[]

  @@index([templateId, date])
}

model RouteStopOccurrence {
  id             String    @id @default(cuid())
  occurrenceId   String
  order          Int
  clientId       String
  eta            DateTime?
  etd            DateTime?
  travelMinPrev  Int?
  distanceKmPrev Float?

  occurrence RouteOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId, order])
}
