// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler 6543
  directUrl = env("DIRECT_URL")   // host direto 5432 (SSL)
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id                String  @id @default(cuid())
  firstName         String
  lastName          String
  email             String  @unique
  phone             String? @unique
  cpf               String? @unique
  street            String?
  number            String?
  district          String?
  city              String?
  uf                String?
  cep               String?
  poolSize          String?
  cleaningFrequency Int?
  cleaningWindow    String?
  payDay            Int?
  notes             String?
  active            Boolean @default(true)

  visits         Visit[]
  visitPlans     VisitPlan[]     @relation("ClientToVisitPlan")
  visitInstances VisitInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Technician {
  id        String  @id @default(uuid())
  userId    String? @unique @db.Uuid
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String  @unique
  phone     String? @map("phone")
  cpf       String? @unique
  street    String? @map("street")
  number    String? @map("number")
  district  String? @map("district")
  city      String? @map("city")
  uf        String? @map("uf")
  cep       String? @map("cep")
  active    Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  phoneDigits String? @map("phone_digits")  // <- importante

  visits         Visit[]
  visitPlans     VisitPlan[]     @relation("TechnicianToVisitPlan")
  visitInstances VisitInstance[]

  @@index([phone])
  @@index([phoneDigits])
}


model Visit {
  id     String   @id @default(uuid())
  date   DateTime
  status String   @default("pending")

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model VisitPlan {
  id           String  @id @default(cuid())
  technicianId String
  clientId     String
  weekdays     Int[] // 1..6 (Seg..Sáb)
  windowStart  Int
  windowEnd    Int
  notes        String?
  order        Int     @default(0)
  active       Boolean @default(true)

  technician Technician @relation("TechnicianToVisitPlan", fields: [technicianId], references: [id])
  client     Client     @relation("ClientToVisitPlan", fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances VisitInstance[]
}

model VisitInstance {
  id        String   @id @default(cuid())
  date      DateTime
  startHour Int
  endHour   Int
  order     Int      @default(100)
  status    String   @default("planned")
  notes     String?

  // 🔵 Importante: CASCADE ao apagar o VisitPlan
  planId String?
  plan   VisitPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, technicianId])
  @@index([planId]) // 🔵 acelera deleteMany/joins por planId
}
