cat > .gitignore <<'EOF'
# Node / Next
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp*
.pnp.js

# Env / secrets
.env
.env.*
!.env.example

# OS/Editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma
prisma/dev.db
prisma/*.db-journal

# vercel
.vercel

